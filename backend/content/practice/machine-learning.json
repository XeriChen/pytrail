      "function_name": "linear_regression",
      "signature": {
        "parameters": [
          {"name": "xs", "type": "list[float]"},
          {"name": "ys", "type": "list[float]"}
        ],
        "returns": "dict[str, float]"
      },
      "starter_code": "def linear_regression(xs: list[float], ys: list[float]) -> dict[str, float]:\n    return {\"slope\": 0.0, \"intercept\": 0.0, \"r_squared\": 0.0}\n",
      "cases": [
        {
          "args": [[1, 2, 3], [2, 4, 6]],
