          "comparison": "approximate",
          "tolerance": 1e-09
        },
        {
          "args": [[0, 1, 2], [1, 3, 5]],
          "expected": {"slope": 2.0, "intercept": 1.0, "r_squared": 1.0},
          "explanation": "验证非零截距。",
          "comparison": "approximate",
          "tolerance": 1e-09
        },
        {
