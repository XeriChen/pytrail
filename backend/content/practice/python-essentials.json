          "expected": [
            {"name": "Eve", "phone_valid": true, "email_valid": false},
            {"name": "Fox", "phone_valid": true, "email_valid": false}
          ],
          "explanation": "邮箱本地部分不能为空，且只能有一个 @。"
        },
        {
          "args": [[]],
