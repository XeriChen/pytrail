        ],
        "returns": "list[dict[str, object]]"
      },
      "starter_code": "def validate_contacts(contacts: list[dict[str, str]]) -> list[dict]:\n    return []\n",
      "cases": [
        {
          "args": [[{"name": " Alice ", "phone": "13800138000", "email": "alice@example.com"}, {"name": "Bob", "phone": "12800138000", "email": "bob@example"}]],
          "expected": [
            {"name": "Alice", "phone_valid": true, "email_valid": true},
            {"name": "Bob", "phone_valid": false, "email_valid": false}
          ],
          "explanation": "第二位不在允许范围内的手机号无效，邮箱域名必须含点。"
        },
        {
          "args": [[{"name": "Carol", "phone": " 19912345678 ", "email": " carol@sub.example.org "}, {"name": "Dan", "phone": "1380013800x", "email": "d an@example.com"}]],
          "expected": [
            {"name": "Carol", "phone_valid": true, "email_valid": true},
            {"name": "Dan", "phone_valid": false, "email_valid": false}
          ],
          "explanation": "首尾空白会被清理，但字段内部的非数字或空白会导致校验失败。"
        },
        {
