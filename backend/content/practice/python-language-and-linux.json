        "returns": "list[list[int]]"
      },
      "starter_code": "def merge_ranges(ranges: list[list[int]]) -> list[list[int]]:\n    return []\n",
      "cases": [
        {
          "args": [[[5, 8], [1, 3], [2, 6], [10, 12]]],
          "expected": [[1, 8], [10, 12]],
